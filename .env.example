# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breathsafe

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (OAuth 2.0 Client ID, "Web application" type)  separate
# from GOOGLE_API_KEY below. Create one at
# https://console.cloud.google.com/apis/credentials, with authorized
# redirect URI {NEXTAUTH_URL}/api/auth/callback/google. Optional: the app
# runs fine on credentials-only auth if these are left unset.
GOOGLE_CLIENT_ID=your-oauth-client-id-here
GOOGLE_CLIENT_SECRET=your-oauth-client-secret-here

# Google Cloud API key with Air Quality API, Pollen API, Geocoding API, and
# Directions API enabled. Server-only  never exposed to the browser. Get one
# at https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your-google-api-key-here

# Groq API key for the AI assistant (free tier, fast inference on open
# models). Get one at https://console.groq.com/keys. Server-only.
GROQ_API_KEY=your-groq-api-key-here

# Separate browser-facing key for the Maps JavaScript SDK (route planner and
# community map). Must have the Maps JavaScript API enabled and should be
# restricted by HTTP referrer in the Google Cloud Console, since it's
# shipped to the client by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key-here

# Optional Map ID for the Maps JavaScript SDK. Advanced markers and
# theme-aware (dark/light) vector maps require one. Create a vector Map ID
# (no cloud style, so the app's colour scheme applies) at
# https://console.cloud.google.com/google/maps-apis/studio/maps
# If unset, the app falls back to Google's public "DEMO_MAP_ID"  fine for
# local development, but set your own for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-vector-map-id-here

# Web Push VAPID keypair, for lock-screen alert notifications. Generate once
# with `npx web-push generate-vapid-keys` and never regenerate afterward —
# doing so invalidates every existing browser subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com
