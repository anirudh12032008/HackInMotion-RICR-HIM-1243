# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breathsafe

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google Cloud API key with Air Quality API, Pollen API, and Geocoding API
# enabled. Server-only — never exposed to the browser. Get one at
# https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your-google-api-key-here

# Separate browser-facing key for the Maps JavaScript SDK (route planner and
# community map). Must have the Maps JavaScript API enabled and should be
# restricted by HTTP referrer in the Google Cloud Console, since it's
# shipped to the client by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key-here
